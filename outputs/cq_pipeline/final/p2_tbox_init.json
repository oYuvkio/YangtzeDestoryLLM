{
  "classes": [
    {
      "name": "DisasterEvent",
      "cn_name": "灾害事件",
      "definition": "在一定时间和空间范围内发生的与长江流域相关的水旱灾害过程，是洪水事件和干旱事件的上位类",
      "examples": [
        "1998年长江特大洪水",
        "2022年长江流域特大干旱",
        "2016年长江流域性洪水"
      ]
    },
    {
      "name": "FloodEvent",
      "cn_name": "洪水事件",
      "definition": "长江干流或支流发生的明显洪水过程，包括流域性洪水和局地暴雨洪水",
      "examples": [
        "1998年长江特大洪水",
        "2016年长江流域性洪水",
        "1954年长江大洪水"
      ]
    },
    {
      "name": "DroughtEvent",
      "cn_name": "干旱事件",
      "definition": "长江流域发生的持续性水资源短缺事件，包括气象干旱、水文干旱和农业干旱",
      "examples": [
        "2022年长江流域特大干旱",
        "2006年川渝大旱",
        "2011年长江中下游干旱"
      ]
    },
    {
      "name": "LowWaterEvent",
      "cn_name": "枯水事件",
      "definition": "长江干流或支流水位持续低于正常水平的水文过程",
      "examples": [
        "2022年长江枯水期",
        "2006年川渝枯水"
      ]
    },
    {
      "name": "HazardFactor",
      "cn_name": "致灾因子",
      "definition": "导致水旱灾害发生的自然或人为因素，是各类具体致灾因子的上位类",
      "examples": [
        "持续强降水",
        "厄尔尼诺事件",
        "围湖造田"
      ]
    },
    {
      "name": "ClimateAnomaly",
      "cn_name": "气候异常",
      "definition": "影响长江流域降水和水文过程的大尺度气候现象",
      "examples": [
        "厄尔尼诺事件",
        "拉尼娜事件",
        "副热带高压异常"
      ]
    },
    {
      "name": "PrecipitationAnomaly",
      "cn_name": "降水异常",
      "definition": "长江流域降水量显著偏离多年平均值的气象现象",
      "examples": [
        "汛期降水偏多",
        "连续少雨",
        "极端暴雨"
      ]
    },
    {
      "name": "HumanActivity",
      "cn_name": "人类活动",
      "definition": "影响长江流域水旱灾害风险的人为因素",
      "examples": [
        "围湖造田",
        "河道采砂",
        "城市化扩张"
      ]
    },
    {
      "name": "DisasterImpact",
      "cn_name": "灾害影响",
      "definition": "水旱灾害造成的各类损失和影响，是具体影响类型的上位类",
      "examples": [
        "人员伤亡",
        "经济损失",
        "农田受灾"
      ]
    },
    {
      "name": "CasualtyImpact",
      "cn_name": "人员伤亡影响",
      "definition": "灾害导致的人员死亡、失踪和受伤情况",
      "examples": [
        "死亡人数",
        "失踪人数",
        "受伤人数"
      ]
    },
    {
      "name": "EconomicLoss",
      "cn_name": "经济损失",
      "definition": "灾害造成的直接和间接经济损失",
      "examples": [
        "直接经济损失",
        "农业损失",
        "工业损失"
      ]
    },
    {
      "name": "AgriculturalImpact",
      "cn_name": "农业影响",
      "definition": "灾害对农业生产造成的影响，包括农田受灾和粮食减产",
      "examples": [
        "农田受灾面积",
        "粮食减产量",
        "灌溉用水短缺"
      ]
    },
    {
      "name": "InfrastructureDamage",
      "cn_name": "基础设施损毁",
      "definition": "灾害对各类基础设施造成的破坏",
      "examples": [
        "堤防溃决",
        "桥梁冲毁",
        "道路损坏"
      ]
    },
    {
      "name": "GeographicRegion",
      "cn_name": "地理区域",
      "definition": "长江流域内的各类地理空间单元，是具体区域类型的上位类",
      "examples": [
        "长江上游",
        "洞庭湖区",
        "武汉市"
      ]
    },
    {
      "name": "AdministrativeRegion",
      "cn_name": "行政区域",
      "definition": "长江流域涉及的省、市、县等行政单元",
      "examples": [
        "湖北省",
        "武汉市",
        "九江市"
      ]
    },
    {
      "name": "Basin",
      "cn_name": "流域单元",
      "definition": "长江干流及主要支流的水文流域单元",
      "examples": [
        "长江上游流域",
        "汉江流域",
        "嘉陵江流域"
      ]
    },
    {
      "name": "Lake",
      "cn_name": "湖泊",
      "definition": "长江流域内的重要湖泊水体",
      "examples": [
        "洞庭湖",
        "鄱阳湖",
        "太湖"
      ]
    },
    {
      "name": "River",
      "cn_name": "河流",
      "definition": "长江干流及主要支流",
      "examples": [
        "长江干流",
        "汉江",
        "嘉陵江",
        "岷江"
      ]
    },
    {
      "name": "HydrologicalStation",
      "cn_name": "水文站",
      "definition": "用于监测水位、流量等水文要素的观测站点",
      "examples": [
        "宜昌站",
        "汉口站",
        "大通站"
      ]
    },
    {
      "name": "FloodControlProject",
      "cn_name": "防洪工程",
      "definition": "用于防御洪水的各类水利工程设施，是具体工程类型的上位类",
      "examples": [
        "三峡水库",
        "荆江大堤",
        "荆江分洪区"
      ]
    },
    {
      "name": "Reservoir",
      "cn_name": "水库",
      "definition": "具有防洪、发电、供水等功能的水利枢纽工程",
      "examples": [
        "三峡水库",
        "丹江口水库",
        "向家坝水库"
      ]
    },
    {
      "name": "Levee",
      "cn_name": "堤防",
      "definition": "沿河流或湖泊修建的防洪挡水建筑物",
      "examples": [
        "荆江大堤",
        "武汉长江干堤",
        "九江长江大堤"
      ]
    },
    {
      "name": "FloodStorageArea",
      "cn_name": "蓄滞洪区",
      "definition": "用于分蓄超额洪水的低洼地区或湖泊洼地",
      "examples": [
        "荆江分洪区",
        "洪湖分洪区",
        "杜家台分洪区"
      ]
    },
    {
      "name": "DroughtReliefProject",
      "cn_name": "抗旱工程",
      "definition": "用于应对干旱的水源工程和供水设施",
      "examples": [
        "应急水源工程",
        "抗旱供水设施",
        "引调水工程"
      ]
    },
    {
      "name": "EmergencyResponse",
      "cn_name": "应急响应",
      "definition": "针对水旱灾害启动的应急管理行动",
      "examples": [
        "防汛IV级响应",
        "抗旱III级响应",
        "防汛I级响应"
      ]
    },
    {
      "name": "EmergencyPlan",
      "cn_name": "应急预案",
      "definition": "针对水旱灾害制定的应急处置方案和程序",
      "examples": [
        "长江流域防汛预案",
        "蓄滞洪区运用预案",
        "抗旱应急预案"
      ]
    },
    {
      "name": "EmergencyMeasure",
      "cn_name": "应急措施",
      "definition": "应急响应期间采取的具体处置行动",
      "examples": [
        "人员转移安置",
        "应急供水",
        "堤防抢险"
      ]
    },
    {
      "name": "ReservoirOperation",
      "cn_name": "水库调度",
      "definition": "水库群的联合运用和调度方案",
      "examples": [
        "防洪调度",
        "蓄水调度",
        "抗旱补水调度"
      ]
    },
    {
      "name": "Organization",
      "cn_name": "组织机构",
      "definition": "参与防汛抗旱工作的政府部门和指挥机构",
      "examples": [
        "长江防汛抗旱指挥部",
        "水利部",
        "应急管理部"
      ]
    },
    {
      "name": "VulnerabilityFactor",
      "cn_name": "脆弱性因素",
      "definition": "影响区域抗灾能力的社会经济和工程因素",
      "examples": [
        "人口密度",
        "防洪标准",
        "应急保障能力"
      ]
    },
    {
      "name": "RiskLevel",
      "cn_name": "风险等级",
      "definition": "区域洪水或干旱风险的分级评价",
      "examples": [
        "高风险区",
        "中风险区",
        "低风险区"
      ]
    },
    {
      "name": "RecoveryProcess",
      "cn_name": "灾后恢复",
      "definition": "灾害发生后的恢复重建过程和机制",
      "examples": [
        "灾后重建",
        "资金保障",
        "生产恢复"
      ]
    }
  ],
